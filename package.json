{
  "name": "redfeng-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:chat": "node --experimental-strip-types tests/chat-flow.test.mts",
    "test:role-lock": "node --experimental-strip-types tests/role-lock.test.mts",
    "verify:account-state": "node --experimental-strip-types tests/chat-flow.test.mts",
